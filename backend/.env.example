# 数据库连接（默认 SQLite；切换到 PostgreSQL 时修改 DATABASE_URL）
# SQLite: sqlite:///./data/growth_world.db
# PostgreSQL: postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/growth_world.db

# 家长初始登录密码（首次启动时创建，请立即修改）
DEFAULT_PARENT_PASSWORD=growth2026

# JWT 密钥（生产环境务必替换为随机强密钥）
SECRET_KEY=please-change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 允许来源（开发用 *）
CORS_ORIGINS=*

# 孩子初始信息
DEFAULT_CHILD_NAME=小勇士
DEFAULT_CHILD_AVATAR=hero_default.png