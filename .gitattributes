# 强制 shell 脚本使用 LF，避免 Windows CRLF 导致容器内执行失败
docker/run.sh text eol=lf

# 源代码文件统一 LF（仓库规范）
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.db binary